# Copy to .env and fill in. Every collector fails loudly with setup
# instructions rather than crashing if its keys are missing.

# --- Reddit ---
# No client id/secret needed — Reddit no longer reliably issues free OAuth
# "script" app credentials for a student/non-commercial account, so
# reddit_collect.py uses Reddit's public unauthenticated .json endpoints
# instead (see problem_statement.md §9). Only a descriptive User-Agent is
# needed; the default below is fine as-is.
REDDIT_USER_AGENT=discovery-engine-myntra-research/0.1 (student grad project)

# --- Groq (free tier: https://console.groq.com/keys) ---
GROQ_API_KEY=
